# SAMANVAY Backend Environment Configuration Example
APP_ENV=development
DEBUG=True

# Host & Port
HOST=127.0.0.1
PORT=8000
API_V1_STR=/api/v1

# Security
SECRET_KEY=samanvay-dev-insecure-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL:
# PostgreSQL (Docker): postgresql://samanvay_user:samanvay_dev_pass_2026@localhost:5432/samanvay_db
# SQLite (Zero-daemon local dev): sqlite:///./samanvay.db
DATABASE_URL=sqlite:///./samanvay.db

# Storage
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]
