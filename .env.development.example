# =====================================================================
# SAMANVAY — Local Development Environment Configuration
# Copy this file to '.env' for local development and testing.
# =====================================================================

# Environment mode: development
APP_ENV=development
DEBUG=True
SEED_SYNTHETIC_DATA=True

# Development Secret Key (Auto-seed users: admin@samanvay.aicte.gov.in / Admin@123)
SECRET_KEY=samanvay-dev-local-secret-key-for-development-purposes-only
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Default: SQLite local quickstart; or local Docker PostgreSQL)
# For local SQLite: sqlite:///./samanvay.db
# For Docker PostgreSQL: postgresql://samanvay_user:samanvay_dev_pass_2026@localhost:5432/samanvay_db
DATABASE_URL=sqlite:///./samanvay.db

# Docker Compose Settings (for local docker compose up)
POSTGRES_DB=samanvay_db
POSTGRES_USER=samanvay_user
POSTGRES_PASSWORD=samanvay_dev_pass_2026
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@samanvay.aicte.gov.in
PGADMIN_PASSWORD=admin123

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Logging
LOG_FORMAT=standard
LOG_LEVEL=DEBUG

# Storage
EVIDENCE_STORAGE_DIR=storage/evidence
EVIDENCE_QUARANTINE_DIR=storage/quarantine
BACKUP_STORAGE_DIR=storage/backups
BACKGROUND_WORKER_HEARTBEAT_PATH=storage/worker_heartbeat.json

# Antivirus (disabled by default in local dev)
MALWARE_SCAN_ENABLED=False
