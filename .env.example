# =====================================================================
# SAMANVAY — Global Environment Configuration Example
# Copy this file to '.env' before running development servers.
# NEVER commit real secret keys or production passwords to git.
# =====================================================================

# Environment mode: development | test | production
APP_ENV=development
DEBUG=True

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=samanvay-dev-insecure-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite fallback for local quick-start)
# For local Docker PostgreSQL: postgresql://samanvay_user:samanvay_dev_pass_2026@localhost:5432/samanvay_db
# For SQLite local fallback: sqlite:///./samanvay.db
DATABASE_URL=sqlite:///./samanvay.db

# Docker Compose PostgreSQL Settings
POSTGRES_DB=samanvay_db
POSTGRES_USER=samanvay_user
POSTGRES_PASSWORD=samanvay_dev_pass_2026
POSTGRES_PORT=5432

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_URL=http://localhost:8000
PORT=5173
