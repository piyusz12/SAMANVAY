# =====================================================================
# SAMANVAY (SIH PS 26264) — Production Environment Configuration
# Copy this file to '.env' on your production host before deployment.
# NEVER commit production credentials, passwords, or secret keys to git.
# =====================================================================

# Environment mode: MUST be 'production'
APP_ENV=production
DEBUG=False
SEED_SYNTHETIC_DATA=False

# Cryptographically Secure Master Secret Key (MUST be at least 32 characters)
# Generate with: openssl rand -hex 32
SECRET_KEY=GENERATE_AND_REPLACE_WITH_MINIMUM_32_CHAR_RANDOM_SECRET_HEX

# JWT Access Token Expiry (in minutes, default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Production PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<db-host>:5432/<dbname>
DATABASE_URL=postgresql://samanvay_user:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/samanvay_db

# PostgreSQL Container Credentials (used by Docker Compose)
POSTGRES_DB=samanvay_db
POSTGRES_USER=samanvay_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_PORT=5432

# Production CORS Allowed Origins (Comma-separated exact domains, NO wildcards)
# Example: https://samanvay.aicte-india.org,https://portal.aicte-india.org
CORS_ORIGINS=https://samanvay.aicte-india.org

# Logging & Observability
# 'json' for ELK / CloudWatch / Datadog, 'standard' for console text
LOG_FORMAT=json
LOG_LEVEL=INFO

# Storage Directories (Mounted on persistent encrypted volumes)
EVIDENCE_STORAGE_DIR=/app/storage/evidence
EVIDENCE_QUARANTINE_DIR=/app/storage/quarantine
BACKUP_STORAGE_DIR=/app/storage/backups
BACKGROUND_WORKER_HEARTBEAT_PATH=/app/storage/worker_heartbeat.json

# File Upload Policies
MAX_ATTACHMENT_SIZE_BYTES=15728640
MAX_ATTACHMENTS_PER_CASE=10

# Antivirus / ClamAV Integration (Optional in air-gapped staging, recommended in production)
MALWARE_SCAN_ENABLED=True
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Background Worker Cadence
ALERT_SCHEDULER_INTERVAL_SECONDS=300
FAILED_DELIVERY_RETRY_INTERVAL_SECONDS=600

# Gunicorn Production Workers
WEB_CONCURRENCY=4
